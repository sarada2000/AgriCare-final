# Copy this file to ".env" (same folder) and change what you need.

# Port for python app.py
PORT=5000

# First officer (admin) account, created the first time the server starts
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=change-me-please

# Your trained model (put the file in backend/model/). Leave empty for demo mode.
# MODEL_PATH=model/paddy_model.keras
# MODEL_NORMALIZE=0-1          # 0-1, -1-1, resnet (resnet50.preprocess_input), or none if the model has its own Rescaling layer
# MODEL_INPUT_SIZE=224         # only used if the model doesn't say its own size
# MIN_CONFIDENCE=0.6           # lower results are marked "uncertain"

# Chat assistant AI (optional). Get a key at https://console.anthropic.com and paste it here.
# Without a key the chat still answers from the website's built-in farm notes.
# ANTHROPIC_API_KEY=sk-ant-...
# CHAT_MODEL=claude-haiku-4-5-20251001

# SMS reminders: "log" writes them to the console; "http" sends through an SMS gateway
SMS_PROVIDER=log
# SMS_API_URL=https://your-sms-gateway/api/send
# SMS_API_KEY=your-key
# SMS_SENDER_ID=AgriCare

# Only needed if the website is hosted on a different address than the API, e.g. GitHub Pages:
# CORS_ORIGINS=https://yourname.github.io

# TIMEZONE=Asia/Colombo

# 1 = without a model file, give clearly marked SAMPLE results (development only)
# 0 = refuse to diagnose until the trained model is loaded (use this for demos and real use)
# ALLOW_DEMO=0
